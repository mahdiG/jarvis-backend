# ──────────────────────────────────────────
# Jarvis Backend - Environment Configuration
# ──────────────────────────────────────────
# Copy this file to .env and adjust values:
#   cp .env.example .env

# ── General ────────────────────────────────
SERVER_PORT=3000
IS_STACK_TRACE_ENABLED=true

# ── Database ──────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=jarvis
DB_PASSWORD=jarvis-pass
DB_NAME=jarvis
DB_SSLMODE=disable

# ── LLM / AI Provider ─────────────────────
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o
# LLM_BASE_URL=       # Uncomment and set for non-OpenAI providers (e.g. DeepSeek, Ollama)
# LLM_MAX_TOKENS=4096 # Uncomment to override default
# LLM_TEMPERATURE=0.7 # Uncomment to override default
